# DeepSeek。请复制为 .env 并填入本地密钥，勿提交 .env。
DEEPSEEK_API_KEY=
FINRISK_LLM_BASE_URL=https://api.deepseek.com
FINRISK_LLM_MODEL=deepseek-flash
FINRISK_LLM_THINKING=disabled
FINRISK_LLM_CONNECT_TIMEOUT=10
FINRISK_LLM_READ_TIMEOUT=90
FINRISK_LLM_MAX_RETRIES=2
FINRISK_LLM_MAX_CONCURRENCY=6
FINRISK_LLM_RETRY_BASE_SECONDS=0.6
# Pi Agent 工具循环预算；要求 Node.js 22.19+ 和 agent_runtime/npm ci。
FINRISK_AGENT_MAX_TURNS=4
# FINRISK_NODE_BINARY=node

# Query 风险展示与相似案例检索门槛（0-1）
FINRISK_RISK_DISPLAY_THRESHOLD=0.20
FINRISK_RETRIEVAL_RISK_THRESHOLD=0.40

# 全量 Qwen 文档/查询同模型，融合后统一重排；索引须预先离线构建。
DASHSCOPE_API_KEY=
FINRISK_EMBEDDING_PROVIDER=cloud
FINRISK_EMBEDDING_MODEL=qwen3.7-text-embedding
FINRISK_EMBEDDING_DIMENSION=1024
# 云 API 默认读取系统代理；可指定代理地址，或设 direct 直连。
# FINRISK_CLOUD_PROXY=direct
# 重排：none（融合原排序）、cloud（Qwen）、deepseek（Pi 列表重排）。
FINRISK_RERANK_PROVIDER=deepseek
FINRISK_RERANK_MODEL=qwen3-rerank
# 默认deepseek由Pi做列表重排；可切换cloud或none。
FINRISK_DEEPSEEK_RERANK_MODEL=deepseek-flash
FINRISK_DEEPSEEK_RERANK_TIMEOUT=20
FINRISK_DEEPSEEK_RERANK_CONCURRENCY=2
# 检索时机：post（判定后）、pre（判定前）、adaptive（自适应前后融合）。
FINRISK_RETRIEVAL_TIMING=adaptive
FINRISK_FULL_CORPUS=true
FINRISK_QUERY_REWRITE=true
FINRISK_QUERY_ANCHORS=0
FINRISK_TYPE_BRIDGE=false
FINRISK_AGENT_RETRIEVAL=true
FINRISK_RISK_LLM_CONCURRENCY=6
# FINRISK_BGE_MODEL_DIR=models/bge-small-zh-v1.5
# FINRISK_BGE_THREADS=4

# 可选路径覆盖；默认值已指向项目内的统一案例库和上传目录。
FINRISK_CASE_KB_ROOT=data/processed/knowledge/finrisk_full_20261024
# FINRISK_RISK_KEYWORD_PATH=data/risk/keyword_db/risk_keyword_db.json
# FINRISK_RAW_CASE_UPLOAD_DIR=data/raw/cases/uploads
# FINRISK_MAX_UPLOAD_SIZE_BYTES=26214400

# 开发集轻量模型与标签示例校准
FINRISK_LOCAL_CALIBRATION=true

# 1600字且20句以上启用全文语义初筛与详细核查协同。
FINRISK_LONGTEXT_SCREENING=true

# 官网增量：随 Web 服务运行，每天北京时间04:30执行一次。
# 空起始日期在首次启动时固定为当天，写入本地状态；不会回补之前的历史。
FINRISK_COLLECTION_ENABLED=true
FINRISK_COLLECTION_START_DATE=
FINRISK_COLLECTION_DAILY_TIME=04:30
FINRISK_COLLECTION_COLUMNS=4113,4114,4115
FINRISK_COLLECTION_OVERLAP_DAYS=3
FINRISK_COLLECTION_DELAY=3
FINRISK_COLLECTION_JITTER=2
FINRISK_COLLECTION_MAX_PAGES=3
FINRISK_COLLECTION_MAX_DETAILS=12
FINRISK_COLLECTION_MAX_REQUESTS=32
