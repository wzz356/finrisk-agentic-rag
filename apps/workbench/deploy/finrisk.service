[Unit]
Description=FinRisk insurance compliance workbench
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=finrisk
Group=finrisk
WorkingDirectory=/opt/finrisk/app
EnvironmentFile=-/etc/finrisk/finrisk.env
Environment=PYTHONUNBUFFERED=1
Environment=FINRISK_COLLECTION_ENABLED=true
ExecStart=/opt/finrisk/venv/bin/python -m uvicorn api.app:app --host 127.0.0.1 --port 8000 --app-dir /opt/finrisk/app/src --workers 1
Restart=on-failure
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
